class UserModel {
  final String uid;
  final String email;
  final String role; // 'customer' or 'company'
  final String fullName;
  final String? phoneNumber; // Optional field
  final String? address; // Optional field
  final String? idNumber; // Optional field

  UserModel({
    required this.uid,
    required this.email,
    required this.role,
    required this.fullName,
    this.phoneNumber,
    this.address,
    this.idNumber,
  });

  factory UserModel.fromMap(Map<String, dynamic> map, String uid) {
    return UserModel(
      uid: uid,
      email: map['email'] ?? '',
      role: map['role'] ?? 'customer',
      fullName: map['fullName'] ?? 'Unknown!',
      phoneNumber: map['phoneNumber'],
      address: map['address'],
      idNumber: map['idNumber'],
    );
  }

  Map<String, dynamic> toMap() {
    return {
      'email': email,
      'role': role,
      'fullName': fullName,
      'phoneNumber': phoneNumber,
      'address': address,
      'idNumber': idNumber,
    };
  }

  @override
  String toString() =>
      'UserModel(uid: $uid, email: $email, role: $role, fullName: $fullName, phoneNumber: $phoneNumber, address: $address, idNumber: $idNumber)';
}
